# Copy to .env.local and fill in real values.
# .env.example is committed; real secrets must NEVER be committed.

# --- Database (Local — Docker) ---
DATABASE_URL="postgresql://rithu:rithu123@localhost:5432/rithudevquest?schema=public"
# Adapter switch: "pg" for Docker local, "neon" for Neon serverless production
DATABASE_ADAPTER="pg"

# --- Database (Production — Neon, optional here) ---
DATABASE_URL_UNPOOLED="postgresql://user:password@host.neon.tech/rithudevquest?sslmode=require"

# --- Auth (Auth.js v5) ---
# Generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- Admin (optional) ---
# When both are set, logging in with these credentials automatically creates /
# promotes a user with role "admin" — no manual seed required to access /admin.
# Leave blank to disable env-driven admin and rely on the normal signup + seed flow.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- AI (Groq) ---
GROQ_API_KEY=""